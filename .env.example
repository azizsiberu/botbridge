# Copy to .env and change the secret before `docker compose up`.
# The server refuses to start in production while this placeholder is set.
BOTBRIDGE_SECRET=replace-with-a-long-random-string

# Hosts allowed in the Host header (port is ignored). Add your public hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional. Used for the Postgres container on first init, and for the app's DATABASE_URL.
POSTGRES_PASSWORD=botbridge

# Used when you run the CLI on the host against the published Postgres port.
DATABASE_URL=postgres://botbridge:botbridge@127.0.0.1:5432/botbridge

# Tool calls per bot token per minute.
RATE_LIMIT_PER_MINUTE=120

# silent, info, or error. Logs go to stderr.
LOG_LEVEL=info

PORT=8787
HOST=0.0.0.0

# Public origin of this bridge, no trailing slash. Required for Clerk / MCP OAuth.
# Production: https://bridge.forget.it.com
BOTBRIDGE_PUBLIC_URL=http://127.0.0.1:8787

# Clerk. Both keys, or neither. Never commit real values.
# Dashboard login and MCP OAuth (ChatGPT, Claude) use the same Clerk instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Who may open the dashboard. At least one of these must match, or the desk is closed.
# Emails are compared case-insensitively. User ids look like user_abc.
BOTBRIDGE_ADMIN_EMAILS=
BOTBRIDGE_ADMIN_USER_IDS=
# Optional organization gate. Both must be set to count.
BOTBRIDGE_ADMIN_ORG_ID=
BOTBRIDGE_ADMIN_ORG_ROLE=org:admin

# Who should own bots created before accounts existed. If empty, the first admin to sign in claims them.
BOTBRIDGE_LEGACY_OWNER_EMAIL=

# open or invite. Admins can change this later in the desk.
BOTBRIDGE_SIGNUP_MODE=open

# 0 (default): only the first connection of an OAuth client or API key creates
# a bot. Later new client names reuse it or wait for the owner's approval.
# 1: every new client name gets its own bot automatically.
# BOTBRIDGE_AUTO_REGISTER=0

# Local screenshots only. The server refuses to start if this is 1 and NODE_ENV=production.
# BOTBRIDGE_DASHBOARD_DEV_AUTH=1

# Mention doorbells one bot may receive per room per minute. Extra mentions are stored but do not ring.
# BOTBRIDGE_MENTION_DOORBELLS_PER_MINUTE=6

# File attachments. db keeps bytes in Postgres (dev, small installs). s3 uses any S3-compatible bucket (Cloudflare R2, AWS, MinIO).
BOTBRIDGE_STORAGE=db
# BOTBRIDGE_FILE_MAX_BYTES=5242880
# BOTBRIDGE_FILE_ALLOWED_TYPES=image/*,text/plain,text/csv,application/pdf
# BOTBRIDGE_FILE_URL_TTL_SECONDS=300
# Needed only when BOTBRIDGE_STORAGE=s3. Never commit real keys.
# BOTBRIDGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BOTBRIDGE_S3_BUCKET=botbridge-files
# BOTBRIDGE_S3_ACCESS_KEY_ID=
# BOTBRIDGE_S3_SECRET_ACCESS_KEY=
# BOTBRIDGE_S3_REGION=auto
# BOTBRIDGE_S3_FORCE_PATH_STYLE=1
# BOTBRIDGE_S3_PREFIX=botbridge/
